{
  "name": "water-hole-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "sync": "npm run build && cap sync android",
    "open": "cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "test": "node --test tests/*.test.mjs && ../../node_modules/.bin/tsx --test tests/platform.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/preferences": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
